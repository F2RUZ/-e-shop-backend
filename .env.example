# ============================================
#  SERVER
# ============================================
PORT=3000
NODE_ENV=development

# Rasm havolalari shu manzil bilan quriladi (seed paytida ishlatiladi)
# Serverda: https://backend.sizning-domeningiz.uz
APP_URL=http://localhost:3000

# ============================================
#  POSTGRESQL BAZA
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=eshop_admin

# true  -> TypeORM jadvallarni avtomatik yaratadi (o'qish/o'rganish uchun qulay)
# false -> productionda migration ishlatiladi
DB_SYNCHRONIZE=true

# ============================================
#  JWT (token)
# ============================================
# Productionda ALBATTA o'zgartiring!
JWT_SECRET=super-maxfiy-kalitni-ozgartiring
JWT_EXPIRES_IN=7d

# ============================================
#  DEFAULT ADMIN (birinchi ishga tushganda yaratiladi)
# ============================================
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123
ADMIN_FULL_NAME=Bosh administrator

# ============================================
#  NAMUNA (demo) MA'LUMOTLAR
# ============================================
# true -> baza bo'sh bo'lsa, 4 ta kategoriya + 10 ta mahsulot qo'shiladi
SEED_DEMO_DATA=true
